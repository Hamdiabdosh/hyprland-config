{
    "custom/hotspot": {
        "exec": "waybar-hotspot status",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "waybar-hotspot toggle",
        "on-click-right": "waybar-hotspot menu",
        "on-click-middle": "waybar-hotspot qr",
        "format": "{}",
        "tooltip": true
    }
}
